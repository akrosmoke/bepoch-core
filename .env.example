# ── $BEPOCH core — environment ──────────────────────────────
# Copy to `.env` and fill in. Never commit the real `.env`.

# HTTP server
PORT=4000
HOST=0.0.0.0

# Base network RPC (used by the on-chain anchor module).
# Get a free endpoint from your provider of choice.
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Registry / anchor contract address on Base.
EPOCH_REGISTRY_ADDRESS=

# Server signer for anchor transactions.
# KEEP THIS SECRET — use a dedicated, low-privilege key.
ANCHOR_SIGNER_PRIVATE_KEY=
